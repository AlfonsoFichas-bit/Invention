<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Invention.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Invention"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Invention">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="#28000000" IsTabStop="True" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBarArea" Grid.Row="0" Background="#C0181A1D" Padding="12,8" MinHeight="40">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image x:Name="LogoImage" Width="24" Height="24" Stretch="Uniform" IsHitTestVisible="False" />
                    <Button x:Name="HomeButton" Click="HomeButton_Click" Visibility="Collapsed" ToolTipService.ToolTip="Volver a la biblioteca" Padding="10,8">
                        <FontIcon Glyph="&#xE80F;" FontSize="16" />
                    </Button>
                    <Button x:Name="ShareButton" Click="ShareButton_Click" IsEnabled="False" Visibility="Collapsed" ToolTipService.ToolTip="Compartir cómic" Padding="10,8">
                        <FontIcon Glyph="&#xE72D;" FontSize="16" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="ComicTitle" Grid.Column="1" Text="Invention Comics" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0" />
                <Grid x:Name="TitleBarRightInset" Grid.Column="3" />
            </Grid>
        </Border>

        <Grid x:Name="HomeView" Grid.Row="1" Grid.RowSpan="2" Background="#16000000">
            <NavigationView x:Name="HomeNavigationView" PaneDisplayMode="LeftCompact" CompactPaneLength="76" IsPaneToggleButtonVisible="False" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" Background="Transparent" SelectionChanged="HomeNavigationView_SelectionChanged">
                <NavigationView.Resources>
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#A0161A20" />
                </NavigationView.Resources>
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Inicio" Tag="Home" Icon="Home" IsSelected="True" />
                    <NavigationViewItem Content="Biblioteca" Tag="Library" Icon="Library" />
                </NavigationView.MenuItems>
                <NavigationView.Content>
                    <Grid>
                        <Image x:Name="DesktopWallpaperImage" Stretch="UniformToFill" IsHitTestVisible="False" />
                        <Border Background="#88000000" IsHitTestVisible="False" />
                        <ScrollViewer x:Name="HomeScrollViewer" VerticalScrollBarVisibility="Auto" Background="Transparent">
                <StackPanel Margin="36,28,32,32" Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="INVENTION COMICS" FontSize="12" CharacterSpacing="150" Foreground="#B8C2D3" />
                            <TextBlock Text="Tu biblioteca" FontSize="32" FontWeight="SemiBold" />
                            <TextBlock x:Name="LibrarySummary" Text="Tus cómics, siempre a mano" Foreground="#D0D7E2" FontSize="14" />
                        </StackPanel>
                        <StackPanel x:Name="HomeStatusPanel" Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0">
                            <Button x:Name="SearchButton" Click="SearchButton_Click" ToolTipService.ToolTip="Buscar cómics" Padding="8,6" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE721;" FontSize="19" />
                            </Button>
                            <TextBox x:Name="SearchTextBox" Width="220" FontSize="16" PlaceholderText="Buscar cómics..." Visibility="Collapsed" TextChanged="SearchTextBox_TextChanged" VerticalAlignment="Center" />
                            <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="Collapsed">
                                <FontIcon Glyph="&#xEBAA;" FontSize="19" />
                                <TextBlock x:Name="BatteryText" FontSize="16" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="ClockText" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Button Click="AddComicsButton_Click" HorizontalAlignment="Right" Margin="0,6,0,0" Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="16" />
                            <TextBlock Text="Añadir cómics" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="LibraryHeading" Text="Añadidos recientemente" FontSize="22" FontWeight="SemiBold" Margin="0,26,0,2" />
                    <TextBlock x:Name="EmptyLibraryState" Text="Tu biblioteca está vacía. Añade archivos CBR para empezar." Foreground="#D0D7E2" FontSize="15" Visibility="Collapsed" Margin="0,8,0,8" />
                    <ItemsControl x:Name="LibraryItemsControl" HorizontalAlignment="Center" ItemsSource="{x:Bind FilteredLibraryComics, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="214" ItemHeight="316" HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ComicLibraryItem">
                                <Button Tag="{x:Bind}" Click="LibraryComic_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Center">
                                    <Button.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Quitar de la biblioteca" Tag="{x:Bind Id}" Click="RemoveComicMenuItem_Click" />
                                        </MenuFlyout>
                                    </Button.ContextFlyout>
                                    <Grid Width="190" Height="292">
                                        <Border Background="#66353A43" CornerRadius="8" />
                                        <TextBlock Text="CBR" FontSize="28" FontWeight="SemiBold" Foreground="#90FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{x:Bind CoverImage, Mode=OneWay}" Stretch="UniformToFill" />
                                        <Border VerticalAlignment="Bottom" Background="#D0181A20" Padding="12,10">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                                <TextBlock Text="{x:Bind DetailText, Mode=OneWay}" FontSize="11" Foreground="#D0D0D5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </NavigationView.Content>
            </NavigationView>
        </Grid>

        <Grid x:Name="ReaderView" Grid.Row="1" Margin="12" Visibility="Collapsed">
            <TextBlock x:Name="EmptyState" Text="Abre un archivo .cbr para empezar a leer" Foreground="#D0D0D5" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ScrollViewer x:Name="PageScrollViewer" ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Visibility="Collapsed" ViewChanged="PageScrollViewer_ViewChanged" SizeChanged="PageScrollViewer_SizeChanged" PointerWheelChanged="PageScrollViewer_PointerWheelChanged">
                <Image x:Name="PageImage" Stretch="Fill" />
            </ScrollViewer>
        </Grid>

        <Border x:Name="ReaderFooter" Grid.Row="2" Background="#C0181A1D" Padding="14,8" Visibility="Collapsed">
            <Grid ColumnDefinitions="*,Auto,*">
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <Button x:Name="PreviousButton" Content="‹" FontSize="24" Padding="10,0" IsEnabled="False" Click="PreviousButton_Click" ToolTipService.ToolTip="Página anterior" />
                    <TextBlock x:Name="PageLabel" Text="0 / 0" MinWidth="70" TextAlignment="Center" VerticalAlignment="Center" Foreground="#E5E5EA" />
                    <Button x:Name="NextButton" Content="›" FontSize="24" Padding="10,0" IsEnabled="False" Click="NextButton_Click" ToolTipService.ToolTip="Página siguiente" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                    <Button Click="ZoomOutButton_Click" IsEnabled="False" x:Name="ZoomOutButton" ToolTipService.ToolTip="Alejar" Padding="8,6">
                        <FontIcon Glyph="&#xE71F;" FontSize="16" />
                    </Button>
                    <Slider x:Name="ZoomSlider" Width="120" Minimum="100" Maximum="400" Value="100" StepFrequency="25" IsEnabled="False" ValueChanged="ZoomSlider_ValueChanged" />
                    <TextBlock x:Name="ZoomLabel" Text="100 %" MinWidth="48" VerticalAlignment="Center" Foreground="#E5E5EA" />
                    <Button Click="ZoomInButton_Click" IsEnabled="False" x:Name="ZoomInButton" ToolTipService.ToolTip="Acercar" Padding="8,6">
                        <FontIcon Glyph="&#xE8A3;" FontSize="16" />
                    </Button>
                    <Button x:Name="FitButton" Content="Ajustar" IsEnabled="False" Click="FitButton_Click" ToolTipService.ToolTip="Ajustar página a la ventana" Padding="10,6" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
